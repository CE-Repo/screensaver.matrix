<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
    <section id="screensaver.matrix">
        <category id="General" label="32039" help="32039">
            <group id="1" label="32019">
                <setting id="show-notifications" type="boolean" label="32011" help="32033">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
                <setting id="show-previewwindow" type="boolean" label="32029" help="32034">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
            </group>
            <group id="2" label="32091">
                <setting id="rain-interval" type="integer" label="32093" help="32094">
                    <level>0</level>
                    <default>5</default>
                    <!-- Zero is the left end of the slider and means the
                         variant never changes. -->
                    <constraints>
                        <minimum>0</minimum>
                        <step>1</step>
                        <maximum>60</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="rain-speed" type="integer" label="32083" help="32084">
                    <level>0</level>
                    <default>1</default>
                    <constraints>
                        <options>
                            <option label="32085">0</option>
                            <option label="32086">1</option>
                            <option label="32087">2</option>
                            <option label="32088">3</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="rain-churn" type="boolean" label="32099" help="32100">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="prepare-textures" type="action" label="32096" help="32097">
                    <level>0</level>
                    <data>RunAddon(screensaver.matrix,prepare)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action" />
                </setting>
            </group>
            <group id="3" label="32014">
                <setting id="check-dpms" type="integer" label="32015" help="32037">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32022">0</option>
                            <option label="32023">1</option>
                            <option label="32024">2</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="dpms-action" type="integer" label="32026" help="">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32027">0</option>
                            <option label="32028">1</option>
                        </options>
                    </constraints>
                    <dependencies>
                        <dependency type="visible">
                            <or>
                                <condition operator="is" setting="check-dpms">1</condition>
                                <condition operator="is" setting="check-dpms">2</condition>
                            </or>
                        </dependency>
                    </dependencies>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="manual-dpms" type="integer" label="32025" help="">
                    <level>0</level>
                    <default>5</default>
                    <!-- The minimum has to sit on the step grid, otherwise the
                         slider offers 1, 6, 11 ... 116 and neither the default
                         of 5 nor the maximum of 120 can ever be selected. -->
                    <constraints>
                        <minimum>5</minimum>
                        <step>5</step>
                        <maximum>120</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="visible">
                            <condition operator="is" setting="check-dpms">2</condition>
                        </dependency>
                    </dependencies>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="toggle-displayoff" type="boolean" label="32016" help="">
                    <level>0</level>
                    <default>false</default>
                    <dependencies>
                        <dependency type="visible">
                            <or>
                                <condition operator="is" setting="check-dpms">1</condition>
                                <condition operator="is" setting="check-dpms">2</condition>
                            </or>
                        </dependency>
                    </dependencies>
                    <control type="toggle" />
                </setting>
                <setting id="toggle-cecoff" type="boolean" label="32017" help="">
                    <level>0</level>
                    <default>false</default>
                    <dependencies>
                        <dependency type="visible">
                            <or>
                                <condition operator="is" setting="check-dpms">1</condition>
                                <condition operator="is" setting="check-dpms">2</condition>
                            </or>
                        </dependency>
                    </dependencies>
                    <control type="toggle" />
                </setting>
            </group>
            <!-- Groups 4 and 5 carry no settings of their own; their labels
                 render the two-line footnote about DPMS below the group above. -->
            <group id="4" label="32020" />
            <group id="5" label="32021">
                <!-- Internal state, not meant for the user: set while our own
                     window is up so the screensaver hook shows the transparent
                     placeholder instead of starting over. The dependency below
                     is never true, which keeps it hidden. -->
                <setting id="last-variant" type="string" label="32000" help="">
                    <level>0</level>
                    <default />
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible">
                            <condition on="property" name="InfoBool">false</condition>
                        </dependency>
                    </dependencies>
                    <control type="edit" format="string" />
                </setting>
                <setting id="is_locked" type="boolean" label="32000" help="">
                    <level>0</level>
                    <default>false</default>
                    <dependencies>
                        <dependency type="visible">
                            <condition on="property" name="InfoBool">false</condition>
                        </dependency>
                    </dependencies>
                    <control type="toggle" />
                </setting>
            </group>
        </category>
        <category id="Variants" label="32092" help="32092">
            <!-- One toggle per variant of the rain. The screensaver picks at
                 random from the ones left switched on. -->
            <group id="1" label="32092">
                <setting id="enable-bugs" type="boolean" label="32061" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-classic" type="boolean" label="32062" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-debug" type="boolean" label="32064" help="32095">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-megacity" type="boolean" label="32065" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-morpheus" type="boolean" label="32066" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-nightmare" type="boolean" label="32067" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-operator" type="boolean" label="32068" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-palimpsest" type="boolean" label="32069" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-paradise" type="boolean" label="32070" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-rainbow" type="boolean" label="32071" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-resurrections" type="boolean" label="32072" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-trinity" type="boolean" label="32073" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="enable-twilight" type="boolean" label="32074" help="32095">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
            </group>
        </category>
    </section>
</settings>
