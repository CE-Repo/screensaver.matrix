<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
    <section id="screensaver.matrix">
        <category id="General" label="32039" help="32039">
            <group id="1" label="32019">
                <setting id="scene-mode" type="integer" label="32077" help="32080">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32078">0</option>
                            <option label="32079">1</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="show-notifications" type="boolean" label="32011" help="32033">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
                <setting id="show-previewwindow" type="boolean" label="32029" help="32034">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
            </group>
            <group id="2" label="32002">
                <setting id="download-folder" type="path" label="32003" help="32035">
                    <level>0</level>
                    <default />
                    <constraints>
                        <writable>false</writable>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="path">
                        <heading>32003</heading>
                    </control>
                </setting>
                <setting id="force-offline" type="boolean" label="32030" help="32032">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
                <setting id="run-downloader" type="action" label="32004" help="32036">
                    <level>0</level>
                    <data>RunAddon(screensaver.matrix,offline)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action" />
                </setting>
            </group>
            <group id="3" label="32014">
                <setting id="check-dpms" type="integer" label="32015" help="32037">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32022">0</option>
                            <option label="32023">1</option>
                            <option label="32024">2</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="dpms-action" type="integer" label="32026" help="">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32027">0</option>
                            <option label="32028">1</option>
                        </options>
                    </constraints>
                    <dependencies>
                        <dependency type="visible">
                            <or>
                                <condition operator="is" setting="check-dpms">1</condition>
                                <condition operator="is" setting="check-dpms">2</condition>
                            </or>
                        </dependency>
                    </dependencies>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="manual-dpms" type="integer" label="32025" help="">
                    <level>0</level>
                    <default>5</default>
                    <!-- The minimum has to sit on the step grid, otherwise the
                         slider offers 1, 6, 11 ... 116 and neither the default
                         of 5 nor the maximum of 120 can ever be selected. -->
                    <constraints>
                        <minimum>5</minimum>
                        <step>5</step>
                        <maximum>120</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="visible">
                            <condition operator="is" setting="check-dpms">2</condition>
                        </dependency>
                    </dependencies>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="toggle-displayoff" type="boolean" label="32016" help="">
                    <level>0</level>
                    <default>false</default>
                    <dependencies>
                        <dependency type="visible">
                            <or>
                                <condition operator="is" setting="check-dpms">1</condition>
                                <condition operator="is" setting="check-dpms">2</condition>
                            </or>
                        </dependency>
                    </dependencies>
                    <control type="toggle" />
                </setting>
                <setting id="toggle-cecoff" type="boolean" label="32017" help="">
                    <level>0</level>
                    <default>false</default>
                    <dependencies>
                        <dependency type="visible">
                            <or>
                                <condition operator="is" setting="check-dpms">1</condition>
                                <condition operator="is" setting="check-dpms">2</condition>
                            </or>
                        </dependency>
                    </dependencies>
                    <control type="toggle" />
                </setting>
            </group>
            <!-- Groups 4 and 5 carry no settings of their own; their labels
                 render the two-line footnote about DPMS below the group above. -->
            <group id="4" label="32020" />
            <group id="5" label="32021">
                <!-- Internal state, not meant for the user: set while our own
                     video is playing so the screensaver hook shows the
                     transparent placeholder instead of starting over. The
                     dependency below is never true, which keeps it hidden. -->
                <setting id="is_locked" type="boolean" label="32000" help="">
                    <level>0</level>
                    <default>false</default>
                    <dependencies>
                        <dependency type="visible">
                            <condition on="property" name="InfoBool">false</condition>
                        </dependency>
                    </dependencies>
                    <control type="toggle" />
                </setting>
            </group>
        </category>
