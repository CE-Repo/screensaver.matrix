msgstr "Przełącz urządzenie w stan czuwania przez CEC"

msgctxt "#32019"
msgid "General settings"
msgstr "Ustawienia ogólne"

msgctxt "#32020"
msgid "* DPMS will check for the Power Saving Kodi settings and stop the screensaver"
msgstr "* DPMS sprawdza ustawienia oszczędzania energii Kodi i zatrzymuje wygaszacz"

msgctxt "#32021"
msgid "if the maximum allowed time to put the display to sleep is exceeded"
msgstr "gdy zostanie przekroczony maksymalny czas do uśpienia ekranu"

