msgctxt "#32000"
msgid "Matrix Screensaver"
msgstr "Salvapantallas Matrix"

msgctxt "#32010"
msgid "Instantiated. Please wait..."
msgstr "Iniciando. Espere..."

msgctxt "#32011"
msgid "Show start notification"
msgstr "Mostrar notificación al iniciar"

msgctxt "#32013"
msgid "Initializing..."
msgstr "Inicializando..."

msgctxt "#32014"
msgid "DPMS*"
msgstr "DPMS*"

msgctxt "#32015"
msgid "DPMS"
msgstr "DPMS"

msgctxt "#32016"
msgid "Toggle display off"
msgstr "Apagar la pantalla"

msgctxt "#32017"
msgid "Put playing device on standby via a CEC"
msgstr "Poner el dispositivo en espera mediante CEC"

msgctxt "#32019"
msgid "General settings"
msgstr "Ajustes generales"

msgctxt "#32020"
msgid "* DPMS will check for the Power Saving Kodi settings and stop the screensaver"
msgstr "* DPMS consulta los ajustes de ahorro de energía de Kodi y detiene el salvapantallas"

msgctxt "#32021"
msgid "if the maximum allowed time to put the display to sleep is exceeded"
msgstr "si se supera el tiempo máximo permitido para apagar la pantalla"

msgctxt "#32022"
msgid "Off"
msgstr "Desactivado"

msgctxt "#32023"
msgid "Kodi"
msgstr "Kodi"

msgctxt "#32024"
msgid "Manual"
msgstr "Manual"

msgctxt "#32025"
msgid "Manual timeout to activate DPMS (min)"
msgstr "Tiempo manual para activar DPMS (min)"

msgctxt "#32026"
msgid "DPMS action"
msgstr "Acción de DPMS"

msgctxt "#32027"
msgid "Pause the rain"
msgstr "Pausar la lluvia"

msgctxt "#32028"
msgid "Stop the rain"
msgstr "Detener la lluvia"

msgctxt "#32029"
msgid "Show preview window"
msgstr "Mostrar la ventana de espera"

msgctxt "#32033"
msgid "Displays a notification when the screensaver starts"
msgstr "Muestra una notificación cuando arranca el salvapantallas"

msgctxt "#32034"
msgid "Shows a loading screen before the rain starts"
msgstr "Muestra una pantalla de carga antes de que empiece la lluvia"

msgctxt "#32037"
msgid "Display Power Management Signaling (DPMS)"
msgstr "Display Power Management Signaling (DPMS)"

