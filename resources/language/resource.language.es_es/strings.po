msgid "Classic"
msgstr "Clásico"

msgctxt "#32064"
msgid "Debug"
msgstr "Depuración"

msgctxt "#32065"
msgid "Megacity (Revolutions)"
msgstr "Megaciudad (Revolutions)"

msgctxt "#32066"
msgid "Morpheus"
msgstr "Morfeo"

msgctxt "#32067"
msgid "Nightmare"
msgstr "Pesadilla"

msgctxt "#32068"
msgid "Operator"
msgstr "Operador"

msgctxt "#32069"
msgid "Palimpsest"
msgstr "Palimpsesto"

msgctxt "#32070"
msgid "Paradise"
msgstr "Paraíso"

msgctxt "#32071"
msgid "Rainbow"
msgstr "Arcoíris"

msgctxt "#32072"
msgid "Resurrections"
msgstr "Resurrections"

msgctxt "#32073"
msgid "Trinity"
msgstr "Trinity"

msgctxt "#32074"
msgid "Twilight"
msgstr "Crepúsculo"

msgctxt "#32081"
msgid "Generating the code rain..."
msgstr "Generando la lluvia de código..."

msgctxt "#32082"
msgid "The code rain could not be generated."
msgstr "No se ha podido generar la lluvia de código."

msgctxt "#32083"
msgid "Speed of the code rain"
msgstr "Velocidad de la lluvia de código"

msgctxt "#32084"
msgid "How fast the columns fall. Normal is the pace the variant sets for itself."
msgstr "A qué velocidad caen las columnas. Normal es el ritmo propio de cada variante."

msgctxt "#32085"
msgid "Slow"
msgstr "Lenta"

msgctxt "#32086"
msgid "Normal"
msgstr "Normal"

msgctxt "#32087"
msgid "Fast"
msgstr "Rápida"

msgctxt "#32088"
msgid "Very fast"
msgstr "Muy rápida"

msgctxt "#32091"
msgid "Code rain"
msgstr "Lluvia de código"

msgctxt "#32092"
msgid "Variants"
msgstr "Variantes"

msgctxt "#32093"
msgid "Minutes per variant (0 = never change)"
msgstr "Minutos por variante (0 = no cambiar nunca)"

msgctxt "#32094"
msgid "How long one variant stays on screen before the next one is picked at random. Zero keeps the one it started with."
msgstr "Cuánto tiempo permanece una variante en pantalla antes de elegir otra al azar. Cero mantiene la inicial."

msgctxt "#32095"
msgid "Include this variant in the rotation."
msgstr "Incluir esta variante en la rotación."

msgctxt "#32096"
msgid "Prepare textures now"
msgstr "Preparar las texturas ahora"

msgctxt "#32097"
msgid "Builds the textures of every variant that is switched on, instead of waiting for each one the first time it appears, and drops the ones that are switched off from the cache."
msgstr "Genera las texturas de todas las variantes activadas, en lugar de esperar la primera vez que aparece cada una, y quita de la caché las desactivadas."

msgctxt "#32098"
msgid "Preparing the textures..."
msgstr "Preparando las texturas..."

msgctxt "#32099"
msgid "Let the glyphs change"
msgstr "Dejar que los glifos cambien"

msgctxt "#32100"
msgid "Glyphs swap for others now and then, the way they do in the films. Switching this off saves about two thirds of the space the textures take."
msgstr "Los glifos se cambian por otros de vez en cuando, como en las películas. Desactivarlo ahorra unos dos tercios del espacio que ocupan las texturas."
