msgctxt "#32015"
msgid "DPMS"
msgstr "DPMS"

msgctxt "#32016"
msgid "Toggle display off"
msgstr "Выключать экран"

msgctxt "#32017"
msgid "Put playing device on standby via a CEC"
msgstr "Переводить устройство в режим ожидания через CEC"

msgctxt "#32019"
msgid "General settings"
msgstr "Общие настройки"

msgctxt "#32020"
msgid "* DPMS will check for the Power Saving Kodi settings and stop the screensaver"
msgstr "* DPMS учитывает настройки энергосбережения Kodi и останавливает заставку"

msgctxt "#32021"
msgid "if the maximum allowed time to put the display to sleep is exceeded"
msgstr "если превышено максимальное время до отключения экрана"

msgctxt "#32022"
msgid "Off"
msgstr "Выключено"

msgctxt "#32023"
msgid "Kodi"
msgstr "Kodi"

msgctxt "#32024"
msgid "Manual"
msgstr "Вручную"

msgctxt "#32025"
msgid "Manual timeout to activate DPMS (min)"
msgstr "Задержка до DPMS вручную (мин)"

msgctxt "#32026"
msgid "DPMS action"
msgstr "Действие DPMS"

msgctxt "#32027"
msgid "Pause the rain"
msgstr "Приостановить дождь"

msgctxt "#32028"
msgid "Stop the rain"
msgstr "Остановить дождь"

msgctxt "#32029"
msgid "Show preview window"
msgstr "Показывать окно загрузки"

msgctxt "#32033"
msgid "Displays a notification when the screensaver starts"
msgstr "Показывает уведомление при запуске заставки"

msgctxt "#32034"
