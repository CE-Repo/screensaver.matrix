<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
    Window of the live code rain. It only brings the black backdrop and the
    loading overlay; the columns themselves are image controls that
    resources/lib/gui/rain.py adds on top once their textures exist.

    Controls 32500 to 32502 make up the loading overlay and disappear once the
    window property "screensaver-matrix-loading" is set to the literal string
    "false". Control 32503 carries the error message and stays empty otherwise.
-->
<window type="window">
    <controls>
        <control type="image">
            <description>Black backdrop the rain falls on</description>
            <posx>0</posx>
            <posy>0</posy>
            <width>1280</width>
            <height>720</height>
            <aspectratio scalediffuse="false" align="center" aligny="center">scale</aspectratio>
            <texture>black.jpg</texture>
        </control>
        <control type="image" id="32500">
            <description>Background image</description>
            <posx>0</posx>
            <posy>0</posy>
            <width>1280</width>
            <height>720</height>
            <colordiffuse>FF555555</colordiffuse>
            <aspectratio scalediffuse="false" align="center" aligny="center">scale</aspectratio>
            <texture>main.jpg</texture>
            <visible>!String.IsEqual(Window.Property(screensaver-matrix-loading),"false")</visible>
        </control>
        <control type="image" id="32501">
            <description>Busy animation</description>
            <posx>40</posx>
            <posy>685</posy>
            <width>30</width>
            <height>30</height>
            <texture>busy.png</texture>
            <aspectratio>keep</aspectratio>
            <animation effect="rotate" start="0" end="360" center="55,700" time="1200" loop="true" condition="true">conditional</animation>
            <visible>!String.IsEqual(Window.Property(screensaver-matrix-loading),"false")</visible>
        </control>
        <control type="label" id="32502">
            <description>Status text next to the busy animation</description>
            <left>90</left>
            <top>655</top>
            <width>600</width>
            <height>90</height>
            <font>font11</font>
            <textcolor>88FFFFFF</textcolor>
            <align>left</align>
            <aligny>center</aligny>
            <label></label>
            <visible>!String.IsEqual(Window.Property(screensaver-matrix-loading),"false")</visible>
        </control>
        <control type="label" id="32503">
            <description>Message shown when the rain could not be generated</description>
            <left>40</left>
            <top>655</top>
            <width>600</width>
            <height>90</height>
            <font>font11</font>
            <textcolor>88FFFFFF</textcolor>
            <align>left</align>
            <aligny>center</aligny>
            <label></label>
        </control>
    </controls>
</window>
